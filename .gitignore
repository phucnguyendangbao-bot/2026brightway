# ════════════════════════════════════════════════════
# BrightWay Career — .gitignore
# ════════════════════════════════════════════════════

# Hero source (anh goc + script tai - khong can commit)
assets/images/hero-source/

# Node / Vercel
node_modules/
.vercel/
.env
.env.local
.env.*.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# Build / dist
dist/
build/
out/
*.min.js
*.min.css
.cache/

# Local config / secrets (KHÔNG commit credentials)
*.local
api/_secrets.js
api/.keys/

# Large / temporary data
*.zip
*.rar
*.7z
*.tar.gz
*.psd
*.ai
*.sketch
*.fig

# Screenshots / recordings
screenshots/
*.png
!assets/**/*.png
!assets/**/*.svg
!assets/**/*.jpg
!assets/**/*.jpeg
!assets/**/*.webp

# Test artifacts
coverage/
.nyc_output/
.eslintcache
.stylelintcache

# Lock-files keep nếu cần; ở đây bỏ pnpm-lock để lean
pnpm-lock.yaml

# Vercel-specific
.vercelignore
